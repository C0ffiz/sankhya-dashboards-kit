{
  "name": "sankhya-dashboards-kit",
  "version": "2.5.0",
  "private": true,
  "type": "module",
  "description": "Kit para criar, empacotar e depurar dashboards HTML5 do Construtor de Componentes de BI do Sankhya (stacks vite, html e jsp)",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "sankhya-dash": "bin/sankhya-dash.mjs"
  },
  "files": [
    "bin",
    "lib",
    "proxy",
    "runtime",
    "modelos",
    "docs",
    "README.md",
    "CHANGELOG.md",
    ".env.example"
  ],
  "scripts": {
    "novo": "node bin/sankhya-dash.mjs novo",
    "dev": "node bin/sankhya-dash.mjs dev",
    "build": "node bin/sankhya-dash.mjs build",
    "diagnostico": "node bin/sankhya-dash.mjs diagnostico",
    "verificar": "node bin/sankhya-dash.mjs verificar",
    "proxy": "node bin/sankhya-dash.mjs proxy",
    "emular": "node bin/sankhya-dash.mjs emular",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "echarts": "^6.1.0",
    "fflate": "^0.8.3",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  }
}
