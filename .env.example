# Copie este arquivo para .env e preencha com as credenciais da API do Sankhya.
# O .env NUNCA deve ser enviado ao GitHub (já está no .gitignore).
# Ele só é lido pelo proxy local (npm run dev) e pela varredura de segredos do build.

# Endereço da API (sem barra no final)
SANKHYA_BASE_URL=https://api.sankhya.com.br

# Credenciais do aplicativo cadastrado no Portal do Desenvolvedor Sankhya
SANKHYA_CLIENT_ID=
SANKHYA_CLIENT_SECRET=

# Token de integração (X-Token) gerado no ERP para esse aplicativo
SANKHYA_X_TOKEN=
